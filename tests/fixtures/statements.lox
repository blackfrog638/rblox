// Variables, assignment, arithmetic.
var a = 1;
a = a + 2;
print a; // 3

// String concatenation.
var s = "hi";
s = s + "!";
print s; // hi!

// Comparisons and equality.
var gt = 3 > 2;
var lt = 3 < 2;
var eq = 3 == 3;
var neq = 3 != 3;
print gt; // true
print lt; // false
print eq; // true
print neq; // false

// Nil and boolean.
var n;
print n; // nil
var bang = !false;
print bang; // true

// Block scope should not leak.
var scoped = "outer";
{
	var scoped = "inner";
}

// Logical operators.
var t = true;
var f = false;
var or_value = t or f;
var and_value = t and f;

// Short-circuit side effects.
var side = 0;
var or_short = true or (side = 1);
var and_short = false and (side = 2);

// For loop desugaring.
var sum = 0;
for (var i = 0; i < 3; i = i + 1) {
	sum = sum + i;
}

// Native function call.
var t0 = clock();

// Function declaration and return.
fun add(x, y) {
  return x + y;
}
var add_result = add(1, 2);

// Implicit nil return.
fun nothing() {
}
var nil_result = nothing();

// Recursion.
fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 1) + fib(n - 2);
}
var fib_result = fib(6);

// --- Closures ---

// 1. Closure captures enclosing variable.
fun makeCounter() {
  var i = 0;
  fun count() {
    i = i + 1;
    return i;
  }
  return count;
}
var counter = makeCounter();
var c1 = counter();
var c2 = counter();
var c3 = counter();

// 2. Two independent closures over same factory.
var counterB = makeCounter();
var b1 = counterB();

// 3. Closure over parameter.
fun makeAdder(x) {
  fun adder(y) {
    return x + y;
  }
  return adder;
}
var add5 = makeAdder(5);
var adder_result = add5(3);

// 4. Closure reads updated variable (late binding).
var closure_late;
{
  var captured = "before";
  fun reader() {
    return captured;
  }
  closure_late = reader;
  captured = "after";
}
var late_result = closure_late();
